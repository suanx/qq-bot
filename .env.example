# ---------- QQ 开放平台 ----------
APP_ID=                      # 机器人 ID
APP_SECRET=                  # 机器人密钥
CALLBACK_PUBLIC_KEY=         # 回调配置里的 Ed25519 公钥（base64 原始 32 字节或 PEM）
SIGN_TOLERANCE=300           # 时间戳容差（秒）

# ---------- 大模型（OpenAI 兼容） ----------
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_ENABLED=1
AI_TIMEOUT_MS=30000
AI_MAX_CONTEXT=10
AI_MAX_TOKENS=800

# ---------- AI 调用限流 ----------
AI_RATE_LIMIT_ENABLED=1
AI_RATE_LIMIT_PER_MIN=10

# ---------- 广告过滤 ----------
AD_FILTER_ENABLED=1
AD_ACTION=delete_mute        # warn | delete | delete_mute
AD_MUTE_SECONDS=600
AD_MUTE_THRESHOLD=3
AD_MUTE_MAX_SECONDS=86400
AD_KICK_THRESHOLD=4          # 第 N 次违规踢出群聊并拉黑（0=关闭；以上均可在后台「群设置」覆盖）
AD_KEYWORDS=                 # 额外关键词，逗号分隔
AD_REGEX=                    # 额外正则，分号分隔

# ---------- 欢迎 / 退群 ----------
WELCOME_ENABLED=1            # 迎宾/送别总开关
WELCOME_MEMBER=              # 新成员进群欢迎词（留空用内置默认；后台「欢迎词设置」优先级更高）
WELCOME_BOT=                 # 机器人进群欢迎词
LEAVE_NOTICE=                # 成员退群提示文案
AUTO_BLACKLIST_ON_LEAVE=1    # 成员退群自动拉黑
JOIN_NOTICE=                 # 入群申请群内通知（留空用内置默认；支持 {name} {source} {time} {tips}）

# ---------- 群管理 ----------
ADMIN_OPENIDS=               # 可用管理指令的 openid，逗号分隔
ADMIN_MAX_MUTE_SECONDS=2592000

# ---------- 管理后台 ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=              # 必填；留空则后台登录接口禁用
ADMIN_SESSION_SECRET=        # 缺省回落到 APP_SECRET
ADMIN_COOKIE_SECURE=1        # 本地 http 调试请设 0

# ---------- 本地调试 ----------
# MOCK=1                     # 打开后 QQ API 只打印不真正请求
# PORT=8788
