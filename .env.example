# ---------- QQ 开放平台 ----------
APP_ID=                      # 机器人 ID
APP_SECRET=                  # 机器人密钥
CALLBACK_PUBLIC_KEY=         # 回调配置里的 Ed25519 公钥（base64 原始 32 字节或 PEM）
SIGN_TOLERANCE=300           # 时间戳容差（秒）

# ---------- 大模型（OpenAI 兼容） ----------
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_ENABLED=1
AI_TIMEOUT_MS=30000
AI_MAX_CONTEXT=10
AI_MAX_TOKENS=800

# ---------- AI 调用限流 ----------
AI_RATE_LIMIT_ENABLED=1
AI_RATE_LIMIT_PER_MIN=10

# ---------- 广告过滤 ----------
AD_FILTER_ENABLED=1
AD_ACTION=delete_mute        # warn | delete | delete_mute
AD_MUTE_SECONDS=600
AD_MUTE_THRESHOLD=3
AD_MUTE_MAX_SECONDS=86400
AD_KEYWORDS=                 # 额外关键词，逗号分隔
AD_REGEX=                    # 额外正则，分号分隔

# ---------- 群管理 ----------
LEAVE_BLACKLIST_ENABLED=0    # 退群拉黑（需内邀权限）
ADMIN_OPENIDS=               # 可用管理指令的 openid，逗号分隔
ADMIN_MAX_MUTE_SECONDS=2592000

# ---------- 管理后台 ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=              # 必填；留空则后台登录接口禁用
ADMIN_SESSION_SECRET=        # 缺省回落到 APP_SECRET
ADMIN_COOKIE_SECURE=1        # 本地 http 调试请设 0

# ---------- 本地调试 ----------
# MOCK=1                     # 打开后 QQ API 只打印不真正请求
# PORT=8788
